# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/claimflow?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=claimflow-enterprise-secure-jwt-secret-key-replace-in-production
JWT_EXPIRES_IN=8h

# Client Application URL (for CORS allowlist)
CLIENT_URL=http://localhost:5173

# AI Extraction Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback / provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Document Storage Path
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

